# Required. Get a key at https://aistudio.google.com/apikey (or use a
# Google Cloud service account with Vertex AI access instead — that path
# needs a different client setup than geminiClient.ts currently has).
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash in geminiClient.ts. Override if
# that model is retired or you want a different Flash-tier model.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Restricts CORS to the deployed web app's origin instead of "*".
# Set this once the client is deployed somewhere with a stable origin.
# ALLOWED_ORIGIN=https://your-panicguard-web-domain.example

# Optional. Cloud Run sets this automatically; only needed for local runs.
# PORT=8080
